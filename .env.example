# Supabase project — safe to expose (anon key is public by design).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. LOCAL TOOLING ONLY — bypasses RLS, never ship in
# the app. Required by scripts/seedCourseGeometry.mjs (the golf_* geometry
# tables are RLS-protected with no insert/delete policy).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Management API token (sbp_...). CI/CD ONLY — never ship in the app.
# Keep this in your CI secrets manager, NOT in a committed file.
# ACCESS_TOKEN_SUPABASE=

# Sentry crash reports (project golf-partner-app). A DSN is a public client key,
# safe to ship in the app. Empty = crash reporting off.
EXPO_PUBLIC_SENTRY_DSN=
